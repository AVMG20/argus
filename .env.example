# Copy to .env, set BETTER_AUTH_URL, then `docker compose up -d`.
# Compose reads this file automatically. Every value has a working default.

# The URL people open in their browser. Session cookies and invitation links are
# built from it, so it has to match exactly — including https and any port.
BETTER_AUTH_URL=https://argus.example.com

# Where events are stored. Leave it unset to use the Postgres that Compose
# starts alongside the app; set it to run against a database you already have.
# DATABASE_URL=postgresql://user:password@db.example.com:5432/argus

# Signs session cookies. Leave it unset and Compose generates one on first start
# and keeps it in the argus_data volume. Set it only if you want to control the
# value yourself — changing it signs everyone out.
# BETTER_AUTH_SECRET=

# Host port the app is published on. Change it when something else already uses
# 3000, or when a reverse proxy sits in front.
# ARGUS_PORT=3000


# --- Local development -------------------------------------------------------
# To run the app outside Docker: `docker compose up -d postgres`, then
# `bun run dev`. The bundled database is published on 127.0.0.1:55329 and that
# is already the built-in default, so leave DATABASE_URL unset for this.
