# Copy to .env, set the two values below, then `docker compose up -d`.
# Compose reads this file automatically.

# The URL people open in their browser. Session cookies and invitation links are
# built from it, so it has to match exactly — including https and any port.
BETTER_AUTH_URL=https://argus.example.com

# Password for the bundled Postgres. Set it before the first start: Postgres
# initialises its volume once, so changing it later does not change the
# password already stored in postgres_data.
POSTGRES_PASSWORD=change-me-to-something-long-and-random

# Signs session cookies. Leave it commented out and Compose generates one on
# first start and keeps it in the argus_data volume. Set it only if you want to
# control the value yourself — changing it signs everyone out.
# BETTER_AUTH_SECRET=

# Published ports. Change ARGUS_PORT when something else already uses 3000, or
# when a reverse proxy sits in front.
# ARGUS_PORT=3000
# POSTGRES_PORT=55329


# --- Local development -------------------------------------------------------
# Only needed to run the app outside Docker (`docker compose up -d postgres`
# followed by `bun run dev`). The app talks to Postgres on the published port,
# and an unset BETTER_AUTH_SECRET falls back to a fixed development secret.
# The password here has to match POSTGRES_PASSWORD above.
# DATABASE_URL=postgresql://argus:change-me-to-something-long-and-random@localhost:55329/argus
# BETTER_AUTH_URL=http://localhost:3000
