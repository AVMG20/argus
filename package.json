{
  "name": "argus",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --bun nuxt build",
    "dev": "bun --bun nuxt dev",
    "preview": "bun --bun nuxt preview",
    "postinstall": "bun --bun nuxt prepare",
    "lint": "bun --bun eslint .",
    "typecheck": "bun --bun nuxt typecheck",
    "db:push": "bun --bun drizzle-kit push",
    "auth:generate": "bunx --bun @better-auth/cli@latest generate --config server/lib/auth.ts --output server/db/schema.ts --yes"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.117",
    "@iconify-json/simple-icons": "^1.2.90",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@nuxt/ui": "^4.10.0",
    "@sentry/browser": "^10.68.0",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.4.8",
    "pg": "^8.22.0",
    "tailwindcss": "^4.3.2",
    "vue-chrts": "^2.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.7"
  },
  "packageManager": "bun@1.3.14"
